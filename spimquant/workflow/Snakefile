rule all_segment:
    input:
        # per-stain, every method: masks and their field fraction
        seg_expand(
            bids(
                root=root,
                datatype="seg",
                stain="{stain}",
                level="{level}",
                desc="{desc}",
                space="{template}",
                suffix="fieldfrac.nii.gz",
                **inputs["spim"].wildcards,
            ),
            kind="mask",
            level=config["registration_level"],
            template=config["template"],
        ),
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="micr",
                stain="{stain}",
                level="{level}",
                space="{template}",
                suffix="SPIM.nii.gz",
                **inputs["spim"].wildcards,
            ),
            stain=stains_for_seg,
            level=config["registration_level"],
            template=config["template"],
        ),
        # per-stain, every method with objects: object counts and regional stats
        seg_expand(
            bids(
                root=root,
                datatype="seg",
                stain="{stain}",
                level="{level}",
                desc="{desc}",
                obj="{obj}",
                suffix="counts.nii.gz",
                **inputs["spim"].wildcards,
            ),
            level=config["registration_level"],
        ),
        seg_expand(
            bids(
                root=root,
                datatype="seg",
                stain="{stain}",
                space="{template}",
                desc="{desc}",
                obj="{obj}",
                suffix="counts.nii.gz",
                **inputs["spim"].wildcards,
            ),
            template=config["template"],
        ),
        seg_expand(
            bids(
                root=root,
                datatype="tabular",
                seg="{seg}",
                from_="{template}",
                stain="{stain}",
                level=config["registration_level"],
                desc="{desc}",
                obj="{obj}",
                suffix="segstats.tsv",
                **inputs["spim"].wildcards,
            ),
            seg=atlas_segs,
            template=config["template"],
        ),
        # cross-stain, primary methods: all objects (with distances), the merged
        # per-region table and its featuremaps
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="tabular",
                space="{template}",
                suffix="regionprops.parquet",
                **inputs["spim"].wildcards,
            ),
            template=config["template"],
        )
        if do_objects
        else [],
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="featuremap",
                seg="{seg}",
                space="{template}",
                suffix="{stain}+{suffix}.nii.gz",
                **inputs["spim"].wildcards,
            ),
            seg=atlas_segs,
            template=config["template"],
            stain=stains_with_objects,
            suffix=config["seg_metrics"],
        ),
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="featuremap",
                seg="{seg}",
                space="{template}",
                suffix="{stain}+{suffix}.nii.gz",
                **inputs["spim"].wildcards,
            ),
            seg=atlas_segs,
            template=config["template"],
            stain=[s for s in stains_for_seg if s not in stains_with_objects],
            suffix=[m for m in config["seg_metrics"] if m in ("fieldfrac", "volume")],
        ),
        expand(
            bids(
                root=root,
                template="{template}",
                seg="{seg}",
                suffix="dseg.{ext}",
            ),
            seg=atlas_segs,
            template=config["template"],
            ext=["tsv", "itksnap.txt"],
        ),


