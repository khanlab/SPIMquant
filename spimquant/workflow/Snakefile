rule all_group_aux:
    """Group-level outputs of additional scans (--aux_spim), for each acquisition.

    The tables and statistics of all_group_merged_tsvs and all_group_stats(_coloc),
    named with the entities of the acquisition (see aux_group_entities); defined
    in groupstats.smk.
    """
    input:
        aux_group_expand(
            bids(
                root=group_stats_root,
                seg="{seg}",
                from_="{template}",
                suffix="allsubjects.{ext}",
                **aux_group_entities,
            ),
            seg=atlas_segs,
            template=config["template"],
            ext=["tsv", "json"],
        )
        if do_merged
        else [],
        aux_group_expand(
            bids(
                root=group_stats_root,
                seg="{seg}",
                from_="{template}",
                contrast="{pairwise_contrast}",
                suffix="groupstats.{ext}",
                **aux_group_entities,
            ),
            seg=atlas_segs,
            template=config["template"],
            pairwise_contrast=pairwise_contrast_labels,
            ext=["png", "tsv", "json"],
        )
        if do_merged and pairwise_contrast_labels
        else [],
        aux_group_expand(
            bids(
                root=group_stats_root,
                seg="{seg}",
                space="{template}",
                contrast="{pairwise_contrast}",
                metric="{metric}",
                suffix="{stat}.nii.gz",
                **aux_group_entities,
            ),
            seg=atlas_segs,
            template=config["template"],
            metric=seg_metric_columns(),
            stat=config["stats_maps"],
            pairwise_contrast=pairwise_contrast_labels,
        )
        if do_seg and pairwise_contrast_labels
        else [],
        aux_group_expand(
            bids(
                root=group_stats_root,
                seg="{seg}",
                space="{template}",
                contrast="{pairwise_contrast}",
                metric="coloc+{metric}",
                suffix="{stat}.nii.gz",
                **aux_group_entities,
            ),
            seg=atlas_segs,
            template=config["template"],
            metric=config["coloc_seg_metrics"],
            stat=config["stats_maps"],
            pairwise_contrast=pairwise_contrast_labels,
        )
        if do_coloc and pairwise_contrast_labels
        else [],


