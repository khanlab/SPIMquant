# --- segmentation: per-stain mask and object methods ---
# Each segmented stain has a primary mask method (--seg_method) and a primary
# object method (--object_method), and optionally comparison methods. Every
# cross-stain result (aggregated objects, colocalization, distances, merged
# tables, featuremaps, group statistics) uses the primaries, so stains segmented
# with different methods are still combined. Only per-stain files carry the
# methods in their names (desc-<seg method>, obj-<object method>).
import sys as _sys

_sys.path.insert(0, os.path.join(workflow.basedir, "scripts"))
from seg_plan import (
    SegPlan,
    SegPlanError,
    apply_gpu_fallback,
    resolve_seg_plan,
    torch_has_cuda,
)

# GPU methods are only used where torch has CUDA (the gpu pixi environment),
# unless --gpu says otherwise
# (yes/no come back from the stored config as YAML booleans)
_gpu_opt = config.get("gpu", "auto")
if _gpu_opt in (True, "yes"):
    gpu_available = True
elif _gpu_opt in (False, "no"):
    gpu_available = False
else:
    gpu_available = torch_has_cuda()

if config["no_segmentation"]:
    seg_plan = SegPlan()
else:
    try:
        seg_plan, _seg_plan_notes = resolve_seg_plan(
            stains,
            config["stains_for_seg"],
            config.get("seg_method"),
            config.get("object_method"),
            config["seg_method_defaults"],
            config["object_method_defaults"],
        )
        _seg_plan_notes += apply_gpu_fallback(
            seg_plan, gpu_available, config["gpu_seg_method_fallbacks"] or {}
        )
    except SegPlanError as _e:
        raise ValueError(str(_e)) from None
    for _note in _seg_plan_notes:
        print(f"Note: {_note}")
    if seg_plan.stains:
        print(
            "Segmentation methods (first of each is primary):\n" + seg_plan.describe()
        )

stains_for_seg = list(seg_plan.stains)
do_seg = len(stains_for_seg) > 0
# stains whose primary object method is not 'none': their primary objects are
# aggregated, colocalized and used for the object distances
stains_with_objects = seg_plan.stains_with_objects
do_objects = len(stains_with_objects) > 0
do_coloc = len(stains_with_objects) > 1

