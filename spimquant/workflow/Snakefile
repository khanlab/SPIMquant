# --aux_spim: additional scans of the same samples (spim_aux), each registered to
# the sample's reference scan (spim) rather than to the template. From here on
# the spim component holds both, so that every per-scan rule and target covers
# the additional scans too; ref_spim_keys and aux_ref_keys tell them apart.
ref_spim_raw = inputs["spim"]
aux_spim_raw = inputs["spim_aux"] if "spim_aux" in inputs else None

# the entities that identify a sample, which a reference scan and its additional
# scans share (the others, e.g. acquisition, tell the scans apart)
_sample_entities = ("subject", "session", "sample")


def _scan_keys(component, wildcards):
    return [
        tuple(component.zip_lists[w][i] for w in wildcards)
        for i in range(len(component.zip_lists[wildcards[0]]))
    ]


if aux_spim_raw is not None:
    if set(aux_spim_raw.zip_lists) != set(ref_spim_raw.zip_lists) or (
        aux_spim_raw.path.replace("{extension}", "")
        != ref_spim_raw.path.replace("{extension}", "")
    ):
        raise ValueError(
            "--aux_spim: the reference scans (spim) and additional scans (spim_aux) "
            "must have the same BIDS entities, so that their outputs are named the "
            "same way:\n"
            f"  spim:     {ref_spim_raw.path}\n  spim_aux: {aux_spim_raw.path}"
        )
    _raw_wildcards = list(ref_spim_raw.zip_lists)
    _pair_wildcards = [w for w in _raw_wildcards if w in _sample_entities]
    _ref_raw_keys = _scan_keys(ref_spim_raw, _raw_wildcards)
    _aux_raw_keys = _scan_keys(aux_spim_raw, _raw_wildcards)

    _overlap = set(_ref_raw_keys) & set(_aux_raw_keys)
    if _overlap:
        raise ValueError(
            "--aux_spim: some scans are selected both as reference scans (spim) and "
            "as additional scans (spim_aux); use --filter-spim and --filter-spim_aux "
            "to split them, e.g. --filter-spim acquisition=1x --filter-spim_aux "
            f"acquisition=12x. Scans in both: {sorted(_overlap)}"
        )

    _refs_by_sample = {}
    for _key in _ref_raw_keys:
        _sample = tuple(_key[_raw_wildcards.index(w)] for w in _pair_wildcards)
        _refs_by_sample.setdefault(_sample, set()).add(
            tuple(v for w, v in zip(_raw_wildcards, _key) if w != "extension")
        )
    _aux_samples = {
        tuple(k[_raw_wildcards.index(w)] for w in _pair_wildcards)
        for k in _aux_raw_keys
    }
    _multi = {
        k: v for k, v in _refs_by_sample.items() if len(v) > 1 and k in _aux_samples
    }
    if _multi:
        raise ValueError(
            "--aux_spim: a sample has more than one reference scan (spim), so its "
            "additional scans cannot be paired; narrow --filter-spim to one scan per "
            f"sample. Samples ({', '.join(_pair_wildcards)}) with several: {_multi}"
        )

    _kept = []
    for _key in _aux_raw_keys:
        _sample = tuple(_key[_raw_wildcards.index(w)] for w in _pair_wildcards)
        if _sample in _refs_by_sample:
            _kept.append(_key)
        else:
            print(
                "Warning: --aux_spim: skipping additional scan "
                f"{dict(zip(_raw_wildcards, _key))}, as there is no reference scan "
                f"(spim) with the same {', '.join(_pair_wildcards)}"
            )
    spim_raw = BidsComponent(
        name="spim",
        path=ref_spim_raw.path,
        zip_lists={
            w: list(ref_spim_raw.zip_lists[w]) + [k[i] for k in _kept]
            for i, w in enumerate(_raw_wildcards)
        },
    )
else:
    spim_raw = ref_spim_raw


# The spim component is generated with `extension` as a wildcard so that one
# path template covers datasets mixing image formats (e.g. .ims files alongside
# .ome.zarr stores). Rules resolve each scan's concrete image path through
# spim_input(); the component exposed to the rest of the workflow has the
# extension stripped so it cannot leak into derived output templates.

_spim_key_wildcards = [w for w in spim_raw.zip_lists if w != "extension"]
_spim_path_lookup = {}
for i, path in enumerate(spim_raw.expand()):
    key = tuple(spim_raw.zip_lists[w][i] for w in _spim_key_wildcards)
    if key in _spim_path_lookup and _spim_path_lookup[key] != path:
        raise ValueError(
            "Ambiguous SPIM inputs: multiple files match the same BIDS entities "
            f"{dict(zip(_spim_key_wildcards, key))}: "
            f"{_spim_path_lookup[key]} and {path}. "
            "Disambiguate by adjusting your BIDS filters."
        )
    _spim_path_lookup[key] = path


def spim_input(wildcards):
    """Concrete raw image path (whatever its extension) for a job's wildcards."""
    key = tuple(getattr(wildcards, w) for w in _spim_key_wildcards)
    try:
        return _spim_path_lookup[key]
    except KeyError as e:
        parts = ", ".join(
            f"{w}={repr(getattr(wildcards, w))}" for w in _spim_key_wildcards
        )
        raise ValueError(
            f"Unable to resolve SPIM input for wildcards ({parts}). "
            "This usually indicates mismatched wildcards or overly restrictive BIDS filters."
        ) from e


def _strip_extension(component, name="spim"):
    return BidsComponent(
        name=name,
        path=component.path.replace("{extension}", ""),
        zip_lists={w: component.zip_lists[w] for w in _spim_key_wildcards},
    )


inputs = BidsDataset(
    {
        **{k: v for k, v in inputs.items() if k != "spim_aux"},
        "spim": _strip_extension(spim_raw),
    },
    layout=inputs.layout,
)

# Reference scans only, for what concerns template registration itself (its QC,
# cohort templates, MRI registration): the additional scans get their template
# transforms through their reference scan instead.
ref_spim = _strip_extension(ref_spim_raw)
ref_spim_keys = set(_scan_keys(ref_spim, _spim_key_wildcards))

# additional scan -> its reference scan, both as entity tuples (_spim_key_wildcards)
aux_ref_keys = {}
if aux_spim_raw is not None:
    _ref_by_sample = {
        tuple(k[_spim_key_wildcards.index(w)] for w in _pair_wildcards): k
        for k in ref_spim_keys
    }
    for _key in _scan_keys(inputs["spim"], _spim_key_wildcards):
        if _key not in ref_spim_keys:
            aux_ref_keys[_key] = _ref_by_sample[
                tuple(_key[_spim_key_wildcards.index(w)] for w in _pair_wildcards)
            ]
    print(
        f"--aux_spim: {len(aux_ref_keys)} additional scan(s), registered to the "
        f"reference scans of {len(set(aux_ref_keys.values()))} sample(s)"
    )

# Group-level outputs of the additional scans are split by the entities that tell
# the scans of a sample apart (e.g. acq): one set per acquisition, named with those
# entities (e.g. acq-12x_...), while the reference scans' keep their names. These
# entities cannot be empty when there are additional scans, as a scan would then
# have the same entities as its reference scan.
aux_group_wildcards = [w for w in _spim_key_wildcards if w not in _sample_entities]
aux_group_entities = {w: f"{{{w}}}" for w in aux_group_wildcards}
aux_groups = sorted(
    {
        tuple(k[_spim_key_wildcards.index(w)] for w in aux_group_wildcards)
        for k in aux_ref_keys
    }
)


def aux_group_expand(pattern, expand_fn=expand, **kwargs):
    """`expand_fn(pattern, **kwargs)` for every acquisition of additional scans."""
    return [
        path
        for group in aux_groups
        for path in expand_fn(
            pattern, **{w: [v] for w, v in zip(aux_group_wildcards, group)}, **kwargs
        )
    ]


def aux_group_scans(wildcards, pattern):
    """`pattern` for every additional scan of the acquisition in `wildcards`."""
    group = tuple(getattr(wildcards, w) for w in aux_group_wildcards)
    return [
        pattern.format(
            **{**dict(wildcards.items()), **dict(zip(_spim_key_wildcards, k))}
        )
        for k in sorted(aux_ref_keys)
        if tuple(k[_spim_key_wildcards.index(w)] for w in aux_group_wildcards) == group
    ]


if "mri" in inputs:
    suffixes = inputs["mri"].entities["suffix"]
    if len(suffixes) == 1:
        if "." in suffixes[0]:
            mri_suffix = suffixes[0].split(".")[0]
        else:
            mri_suffix = suffixes[0]
