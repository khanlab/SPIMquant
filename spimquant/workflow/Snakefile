            stain=stain_for_plaques,
        ),


rule all_segment:
    input:
        seg_expand(
            bids(
                root=root,
                datatype="featuremap",
                seg="{seg}",
                space="{template}",
                desc="{desc}",
                suffix="{stain}+{suffix}.nii.gz",
                **inputs["spim"].wildcards,
            ),
            seg=atlas_segs,
            template=config["template"],
            suffix=config["seg_metrics"],
        ),
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="micr",
                stain="{stain}",
                level="{level}",
                space="{template}",
                suffix="SPIM.nii.gz",
                **inputs["spim"].wildcards,
            ),
            stain=stains_for_seg,
            level=config["registration_level"],
            template=config["template"],
        ),
        seg_expand(
            bids(
                root=root,
                datatype="seg",
                stain="{stain}",
                level="{level}",
                desc="{desc}",
                space="{template}",
                suffix="fieldfrac.nii.gz",
                **inputs["spim"].wildcards,
            ),
            level=config["registration_level"],
            template=config["template"],
        ),
        seg_expand(
            bids(
                root=root,
                datatype="seg",
                stain="{stain}",
                level="{level}",
                desc="{desc}",
                suffix="counts.nii.gz",
                **inputs["spim"].wildcards,
            ),
            level=config["registration_level"],
        ),
        seg_expand(
            bids(
                root=root,
                datatype="seg",
                stain="{stain}",
                space="{template}",
                desc="{desc}",
                suffix="counts.nii.gz",
                **inputs["spim"].wildcards,
            ),
            template=config["template"],
        ),
        expand(
            bids(
                root=root,
                template="{template}",
                seg="{seg}",
                suffix="dseg.{ext}",
            ),
            seg=atlas_segs,
            template=config["template"],
            ext=["tsv", "itksnap.txt"],
        ),


rule all_segment_coloc:
    input:
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="featuremap",
