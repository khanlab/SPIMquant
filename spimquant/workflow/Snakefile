    _alias, _sep, _canonical = str(_spec).partition("=")
    if not _sep or not _alias or not _canonical:
        raise ValueError(
            f"--stain-synonyms expects ALIAS=CANONICAL (e.g. PI=YoPro), got {_spec!r}"
        )
    stain_synonyms[_alias] = _canonical
if stain_synonyms:
    print(
        "Stain synonyms: "
        + ", ".join(f"{a} -> {c}" for a, c in sorted(stain_synonyms.items()))
    )


# prepopulate json sidecar metadata for every spim input
spim_json_overrides = {
    str(spim_path): get_spim_json_overrides(spim_path)
    for spim_path in spim_raw.expand()
}
zarrnii_cli_kwargs = {}

# N4 fits a B-spline grid to the image at correction_level; on a small image
# (e.g. the test dataset) a coarse level leaves too few voxels per axis for the
# grid ("number of control points must be greater than the spline order").
# Use the coarsest level up to correction_level that keeps every axis of every
# scan at least this long.
_MIN_N4_VOXELS = 16
if config["correction_method"] == "n4" and config["correction_level"] > 0:
    _level = config["correction_level"]
    for _spim_path in spim_raw.expand():
        while _level > 0 and (
            min(
                n
                for d, n in get_spim_info(str(_spim_path), _level)["shape"].items()
                if d in ("x", "y", "z")
            )
            < _MIN_N4_VOXELS
        ):
            _level -= 1
    if _level != config["correction_level"]:
        print(
            f"Note: using --correction-level {_level} instead of "
            f"{config['correction_level']}: at that level an image has fewer "
            f"than {_MIN_N4_VOXELS} voxels along an axis, too few for N4"
        )
        config["correction_level"] = _level


def get_zarrnii_in_kwargs(wildcards, input):
    spim_input = getattr(input, "spim", None)
    if spim_input is None:
        # Some rules may pass positional input lists; use the first entry as SPIM input.
        if len(input) == 0:
            raise ValueError(
                f"Unable to resolve SPIM input path for zarrnii kwargs for wildcards: {wildcards}."
                "Make sure the zarrnii input for the rule is named spim, or is the first positional input."
            )
        spim_input = input[0]
    spim_path = str(spim_input)
    kwargs = dict(spim_json_overrides.get(spim_path, {}))
    # CLI options are highest precedence and intentionally override sidecar values.
    kwargs.update(zarrnii_cli_kwargs)
    return kwargs


zarrnii_in_kwargs = get_zarrnii_in_kwargs

