                suffix="coloccounts.nii.gz",
                **inputs["spim"].wildcards,
            ),
            desc=coloc_seg_methods,
            template=config["template"],
        ),


rule all_mri_reg:
    input:
        get_mri_reg_targets(
            bids(
                root=root,
                datatype="anat",
                space="{template}",
                via="SPIM",
                desc="preproc",
                suffix=f"{mri_suffix}.nii.gz",
                **inputs["spim"].wildcards,
            ),
            template=config["template"],
        ),
        get_mri_reg_targets(
            bids(
                root=root,
                datatype="xfm",
                from_=f"{mri_suffix}",
                to="SPIM",
                suffix="regqc.html",
                **inputs["spim"].wildcards,
            ),
        ),


rule all_spim_patches:
    input:
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="seg",
                stain="{stain}",
                seg="{seg}",
                from_="{template}",
                level="{level}",
                desc="{desc}",
                suffix="SPIM.patches",
                **inputs["spim"].wildcards,
            ),
            stain=stains_for_seg,
            seg=patch_atlas_segs,
            template=config["template"],
            level=config["segmentation_level"],
            desc=["raw", "corrected" + config["correction_method"]],
        ),
        seg_expand(
            bids(
                root=root,
                datatype="seg",
                stain="{stain}",
                seg="{seg}",
                from_="{template}",
                level="{level}",
                desc="{desc}",
                suffix="mask.patches",
                **inputs["spim"].wildcards,
            ),
            seg=patch_atlas_segs,
            template=config["template"],
            level=config["segmentation_level"],
        ),


rule all_imaris_crops:
