            ),
            level=config["plaque_level"],
            stain=stain_for_plaques,
        ),
        inputs["spim"].expand(
            bids_oz_in(
                root=root,
                datatype="seg",
                stain="{stain}",
                level="{level}",
                desc=config["plaque_seg_method"],
                suffix="mask.{ext}",
                **inputs["spim"].wildcards,
            ),
            level=config["segmentation_level"],
            stain=stain_for_plaques,
        ),
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="seg",
                stain="{stain}",
                level="{level}",
                desc=config["plaque_seg_method"],
                space="{template}",
                suffix="fieldfrac.nii.gz",
                **inputs["spim"].wildcards,
            ),
            level=config["registration_level"],
