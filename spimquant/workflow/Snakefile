rule all_qc:
    """Target rule for subject-level visual QC outputs."""
    input:
        # Intensity histograms for every stain channel
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="qc",
                stain="{stain}",
                suffix="histogram.png",
                **inputs["spim"].wildcards,
            ),
            stain=stains,
        ),
        # Segmentation overview figures (per stain, per seg method)
        seg_expand(
            bids(
                root=root,
                datatype="qc",
                stain="{stain}",
                desc="{desc}",
                suffix="segslices.png",
                **inputs["spim"].wildcards,
            ),
            kind="mask",
        )
        if do_seg
        else [],
        # Segmentation ROI zoom montage (per stain, per atlas, per seg method)
        seg_expand(
            bids(
                root=root,
                datatype="qc",
                seg="{seg}",
                from_="{template}",
                stain="{stain}",
                desc="{desc}",
                suffix="roimontage.png",
                **inputs["spim"].wildcards,
            ),
            kind="mask",
            seg=atlas_segs,
            template=config["template"],
        )
        if do_seg
        else [],
        # Segmentation ROI zoom montage - no mask overlay
        seg_expand(
            bids(
                root=root,
                datatype="qc",
                seg="{seg}",
                from_="{template}",
                stain="{stain}",
                desc="{desc}nomask",
                suffix="roimontage.png",
                **inputs["spim"].wildcards,
            ),
            kind="mask",
            seg=atlas_segs,
            template=config["template"],
        )
        if do_seg
        else [],
        # Vessel overview figures
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="qc",
                stain="{stain}",
                desc="{desc}",
                suffix="vesselslices.png",
                **inputs["spim"].wildcards,
            ),
            stain=stain_for_vessels,
            desc=config["vessel_seg_method"],
        )
        if do_vessels
        else [],
        # Vessel ROI zoom montage (per atlas)
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="qc",
                seg="{seg}",
                from_="{template}",
                stain="{stain}",
                desc="{desc}",
                suffix="vesselroimontage.png",
                **inputs["spim"].wildcards,
            ),
            seg=atlas_segs,
            template=config["template"],
            stain=stain_for_vessels,
            desc=config["vessel_seg_method"],
        )
        if do_vessels
        else [],
        # Vessel ROI zoom montage - no mask overlay
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="qc",
                seg="{seg}",
                from_="{template}",
                stain="{stain}",
                desc="{desc}nomask",
                suffix="vesselroimontage.png",
                **inputs["spim"].wildcards,
            ),
            seg=atlas_segs,
            template=config["template"],
            stain=stain_for_vessels,
            desc=config["vessel_seg_method"],
        )
        if do_vessels
        else [],
        # Z-profile QC (per stain, per seg method)
        seg_expand(
            bids(
                root=root,
                datatype="qc",
                stain="{stain}",
                desc="{desc}",
                suffix="zprofile.png",
                **inputs["spim"].wildcards,
            ),
            kind="mask",
        )
        if do_seg
        else [],
        # Object-level statistics (per stain, per seg method)
        seg_expand(
            bids(
                root=root,
                datatype="qc",
                stain="{stain}",
                desc="{desc}",
                obj="{obj}",
                suffix="objectstats.png",
                **inputs["spim"].wildcards,
            ),
        )
        if do_seg
        else [],
        # Per-ROI summary (per atlas seg, per seg method)
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="qc",
                seg="{seg}",
                from_="{template}",
                suffix="roisummary.png",
                **inputs["spim"].wildcards,
            ),
            seg=atlas_segs,
            template=config["template"],
        )
        if do_seg
        else [],
        # Instance-centred animated GIFs (per stain, per atlas seg, per seg method)
        seg_expand(
            [
                bids(
                    root=root,
                    datatype="qc",
                    seg="{seg}",
                    from_="{template}",
                    stain="{stain}",
                    desc="{desc}",
                    obj="{obj}",
                    suffix="instancerandom.gif",
                    **inputs["spim"].wildcards,
                ),
                bids(
                    root=root,
                    datatype="qc",
                    seg="{seg}",
                    from_="{template}",
                    stain="{stain}",
                    desc="{desc}",
                    obj="{obj}",
                    suffix="instancesorted.gif",
                    **inputs["spim"].wildcards,
                ),
            ],
            seg=atlas_segs,
            template=config["template"],
        )
        if do_seg and config["qc_instance_seg"]
        else [],
        # Colocalization instance GIFs (per atlas seg, per seg method)
        inputs["spim"].expand(
            [
                bids(
                    root=root,
                    datatype="qc",
                    seg="{seg}",
                    from_="{template}",
                    suffix="colocinstancerandom.gif",
                    **inputs["spim"].wildcards,
                ),
                bids(
                    root=root,
                    datatype="qc",
                    seg="{seg}",
                    from_="{template}",
                    suffix="colocinstancesorted.gif",
                    **inputs["spim"].wildcards,
                ),
            ],
            seg=atlas_segs,
            template=config["template"],
        )
        if do_coloc and config["qc_instance_seg"]
        else [],


# merged per-region tables exist when anything is segmented or fibres are analysed
do_merged = do_seg or do_fibres


rule all_tabular_sidecars:
    """Target rule for JSON sidecar files alongside all non-temp tabular outputs."""
    input:
        # --- participant-level TSV sidecars ---
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="tabular",
                seg="{seg}",
                from_="{template}",
                suffix="mergedsegstats.json",
                **inputs["spim"].wildcards,
            ),
            seg=atlas_segs,
            template=config["template"],
        )
        if do_merged
        else [],
        seg_expand(
            bids(
                root=root,
                datatype="tabular",
                seg="{seg}",
                from_="{template}",
                stain="{stain}",
                level=config["registration_level"],
                desc="{desc}",
                obj="{obj}",
                suffix="{suffix}.json",
                **inputs["spim"].wildcards,
            ),
            seg=atlas_segs,
            template=config["template"],
            suffix=["regionpropstats", "segstats"],
        ),
        # --- participant-level parquet sidecars ---
        inputs["spim"].expand(
            bids(
                root=root,
                datatype="tabular",
                space="{template}",
                suffix="{suffix}.json",
                **inputs["spim"].wildcards,
            ),
            template=config["template"],
            suffix=["regionprops"] + (["coloc"] if do_coloc else []),
        )
        if do_objects
        else [],


rule all_group_stats_tabular_sidecars:
    """Target rule for JSON sidecar files alongside all non-temp tabular outputs."""
    input:
        # --- per-contrast group-level TSV sidecars ---
        expand(
            bids(
                root=group_stats_root,
                seg="{seg}",
                from_="{template}",
                contrast="{pairwise_contrast}",
                suffix="groupstats.json",
            ),
            seg=atlas_segs,
            template=config["template"],
            pairwise_contrast=pairwise_contrast_labels,
        )
        if do_merged and pairwise_contrast_labels
        else [],
        # --- merged all-subjects TSV sidecars ---
        expand(
            bids(
                root=group_stats_root,
                seg="{seg}",
                from_="{template}",
                suffix="allsubjects.json",
            ),
            seg=atlas_segs,
            template=config["template"],
        )
        if do_merged
        else [],
        # --- group-level parquet sidecars ---
        expand(
            bids(
                root=group_stats_root,
                space="{template}",
                suffix="{suffix}.json",
            ),
            template=config["template"],
            suffix=["regionprops"] + (["coloc"] if do_coloc else []),
        )
        if do_objects
        else [],


rule all_group_merged_tsvs:
    """Target rule for group-level merged all-subjects TSV files."""
    input:
        # Merged segstats TSV (all subjects, no contrast) – always produced
        expand(
            bids(
                root=group_stats_root,
                seg="{seg}",
                from_="{template}",
                suffix="allsubjects.tsv",
            ),
            seg=atlas_segs,
            template=config["template"],
        )
        if do_merged
        else [],


rule all_group_merged_regionpropstats_tsvs:
    """Target rule for group-level merged all-subjects regionpropstats TSV files."""
    input:
        seg_expand_plain(
            bids(
                root=group_stats_root,
                seg="{seg}",
                from_="{template}",
                stain="{stain}",
                level="{level}",
                desc="{desc}",
                obj="{obj}",
                suffix="allsubjects_regionpropstats.{ext}",
            ),
            seg=atlas_segs,
            template=config["template"],
            level=[config["registration_level"]],
            ext=["json", "tsv"],
        ),


def _res_entity(res_um):
    """Resolution in um as a res- entity value: 2.5 -> '2p5', 10 -> '10'."""
    r = float(res_um)
    return str(int(r)) if r.is_integer() else f"{r:g}".replace(".", "p")


template_spim_desc = (
    "corrected{method}".format(method=config["correction_method"])
    if config.get("template_spim_corrected")
    else "raw"
)


rule all_template_spim_zarr:
    """Target rule for SPIM data resampled into template space (OME-Zarr).

    One OME-Zarr per subject, stain and --template_spim_res resolution, sampled
    from pyramid level --template_spim_level.
    """
    input:
        inputs["spim"].expand(
            bids_oz_in(
                root=root,
                datatype="micr",
                stain="{stain}",
                space="{template}",
                res="{res}um",
                desc=template_spim_desc,
                level=config["template_spim_level"],
                suffix="SPIM.{ext}",
                **inputs["spim"].wildcards,
            ),
            stain=stains,
            template=config["template"],
            res=[_res_entity(r) for r in config.get("template_spim_res") or []],
        ),


rule all_bbox_template_crops:
    """Target rule to generate all custom bounding box crops in template space.

    Expands over all bounding boxes defined in the --bbox_config YAML and all
    stains present in the dataset.  Each bounding box produces one NIfTI file
    per subject per stain at the resolution and input level specified in the
    config.
    """
    input:
        [
            inputs["spim"].expand(
                bids(
                    root=root,
                    datatype="micr",
                    stain="{stain}",
                    space="{template}",
                    res=f"{bbox['resolution_um']}um",
                    desc=bbox["name"],
                    level=bbox.get("input_level", 0),
                    suffix="SPIM.nii.gz",
                    **inputs["spim"].wildcards,
                ),
                stain=stains,
                template=config["template"],
            )
            for bbox in bbox_configs
        ],


