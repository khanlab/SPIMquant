def seg_metric_columns(stains_list=None):
    """``<stain>+<metric>`` columns of the merged table for segmented stains.

    Stains with --object_method none have field fraction and volume only.
    """
    out = []
    for stain in stains_for_seg if stains_list is None else stains_list:
        metrics = config["seg_metrics"]
        if not seg_plan[stain].has_objects:
            metrics = [m for m in metrics if m in ("fieldfrac", "volume")]
        out += [f"{stain}+{m}" for m in metrics]
    return out


rule all_group_stats:
    """Target rule for group-level statistical analysis."""
    input:
        # Per-contrast groupstats TSV and PNG
        expand(
            bids(
                root=group_stats_root,
                seg="{seg}",
                from_="{template}",
                contrast="{pairwise_contrast}",
                suffix="groupstats.{ext}",
            ),
            seg=atlas_segs,
            template=config["template"],
            pairwise_contrast=pairwise_contrast_labels,
            ext=["png", "tsv"],
        ),
        # Per-contrast NIfTI stat maps for each seg metric
        expand(
            bids(
                root=group_stats_root,
                seg="{seg}",
                space="{template}",
                contrast="{pairwise_contrast}",
                metric="{metric}",
                suffix="{stat}.nii.gz",
            ),
            seg=atlas_segs,
            template=config["template"],
            metric=seg_metric_columns(),
            stat=config["stats_maps"],
            pairwise_contrast=pairwise_contrast_labels,
        ),
        # All-subjects count maps (not contrast-specific)
        expand(
            bids(
                root=group_stats_root,
                level="{level}",
                space="{template}",
                suffix="{stain}+count.nii.gz",
            ),
            stain=stains_with_objects,
            template=config["template"],
            level=range(4),
        ),


